# Live sources for AI discovery + enrichment. All optional: without a key, that
# source degrades to a labelled fallback (curated seed / reviewed base data).
# Overpass (UK location counts) needs no key.
# Do NOT commit real keys. Do NOT use production Sustainium credentials.

# Google Gemini — AI company discovery (best free tier, via Google AI Studio):
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# UK Companies House Public Data API (free): https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# Hunter.io (free tier, 50 credits) — email finding + real mailbox verification:
# https://hunter.io/api-keys
HUNTER_API_KEY=

# Vercel Blob — persist the live-pull cache on Vercel (data/cache.json locally).
# Create a Blob store in the dashboard, connect this project; Vercel injects the token.
# Leave empty for localhost so Refetch keeps writing data/cache.json.
# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=
